{
  "name": "mytube",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply mytube-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply mytube-db --remote"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "jose": "^6.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "miniflare": "^5.20261012.1-beta",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
